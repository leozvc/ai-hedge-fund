# Two-stage: build Vite static assets, serve via nginx
FROM node:20-alpine AS build

WORKDIR /app
COPY app/frontend/package*.json ./
RUN npm ci

COPY app/frontend ./
# Vite bakes API base URL at build time. /api path lets nginx reverse-proxy it.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
# ponytail: upstream `tsc && vite build` fails on this repo (sidebar.tsx Radix ref typing).
# Drop tsc — vite build emits JS, runtime types are not enforced.
RUN npx vite build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80